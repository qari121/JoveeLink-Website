{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/artist/:artistId",
      "destination": "/artist?artistId=:artistId"
    },
    {
      "source": "/community/post/:postId",
      "destination": "https://us-central1-joveelink.cloudfunctions.net/sharePreview/community/post/:postId"
    },
    {
      "source": "/community/profile/:userId",
      "destination": "https://us-central1-joveelink.cloudfunctions.net/sharePreview/community/profile/:userId"
    },
    {
      "source": "/salon/:salonId",
      "destination": "/salon?salonId=:salonId"
    },
    {
      "source": "/r/:code",
      "destination": "/r?code=:code"
    }
  ],
  "headers": [
    {
      "source": "/.well-known/apple-app-site-association",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/.well-known/assetlinks.json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    }
  ]
}
