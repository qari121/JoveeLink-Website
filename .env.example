# TikTok Events API — required for /api/tiktok-track.js to actually forward
# events server-side. Without this, the endpoint returns { ok: false, reason:
# "no_token" } and only the client-side Pixel (ttq.track) fires.
#
# Generate the token in TikTok Events Manager:
#   Events Manager → your pixel (Jovee AR) → Settings → Events API →
#   Generate access token. Copy it immediately — TikTok won't show it again.
#
# Add to Vercel:
#   Project Settings → Environment Variables → add TIKTOK_ACCESS_TOKEN
#   for Production, Preview, and Development. Redeploy after adding.
TIKTOK_ACCESS_TOKEN=

# Optional. Defaults to the Jovee AR pixel ID hardcoded in api/tiktok-track.js.
# Only set this if you swap pixels.
TIKTOK_PIXEL_ID=DA0FUTJC77UDKVSV2FQG
